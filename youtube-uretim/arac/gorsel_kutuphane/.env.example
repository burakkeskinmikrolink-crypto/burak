# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env dosyası git'e GÖNDERİLMEZ.

# https://www.pexels.com/api/ adresinden ücretsiz anahtar
PEXELS_API_KEY=

# https://pixabay.com/api/docs/ adresinden ücretsiz anahtar (giriş yapınca sayfada görünür)
PIXABAY_API_KEY=

# NASA Image and Video Library anahtar istemez; boş bırakılabilir
NASA_API_KEY=

# Wikimedia politikası: iletişim bilgisi içeren bir User-Agent
WIKIMEDIA_USER_AGENT=gorsel-kutuphane/0.1 (YouTube production tool; contact: your-email@example.com)
